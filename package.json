{
  "name": "agenthr",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "pnpm build:main && pnpm build:plugin && pnpm build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:plugin": "tsc -p tsconfig.plugin.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.plugin.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "pnpm build:main && pnpm build:plugin && node --test tests/*.test.mjs && node scripts/smoke-dsh-agent-tools.mjs",
    "package:dir": "pnpm build && node scripts/package-dir.mjs && node scripts/verify-packaged-runtime.mjs && node scripts/smoke-dsh-host.mjs --packaged",
    "verify:package": "node scripts/verify-packaged-runtime.mjs",
    "smoke:host": "pnpm build:main && pnpm build:plugin && node scripts/smoke-dsh-host.mjs",
    "smoke:host:restart": "pnpm build:main && pnpm build:plugin && node scripts/smoke-dsh-host-restart.mjs",
    "smoke:host:package": "node scripts/smoke-dsh-host.mjs --packaged",
    "smoke:agent-tools": "pnpm build:main && pnpm build:plugin && node scripts/smoke-dsh-agent-tools.mjs",
    "smoke:gui:package": "node scripts/smoke-electron-gui.mjs",
    "smoke:browser-use": "pnpm build:main && electron scripts/smoke-electron-browser-use.mjs",
    "smoke:cdp": "pnpm build:main && electron scripts/smoke-electron-cdp.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@phosphor-icons/react": "^2.1.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/cordis-plugin-group": "1.0.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-authorization": "0.1.5-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-jobs": "0.1.5-rc.2",
    "@deepseek-ai/dsh-output-retention": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-telemetry": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-title-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-shell": "0.1.5-rc.2",
    "@deepseek-ai/dsh-spill": "0.1.5-rc.2",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-util-time": "0.1.5-rc.2",
    "@deepseek-ai/dsh-workflow": "0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-app-boot": "0.1.5-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "linkedom": "^0.18.13",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.agenthr.desktop",
    "productName": "AgentHR",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": false,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
